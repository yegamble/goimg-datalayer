# ============================================================================
# Multi-stage Dockerfile for Background Worker
# ============================================================================
# Build stage uses full Go image, runtime uses minimal Alpine image
# Security features:
# - Non-root user (10001:10001)
# - Minimal attack surface
# - Static binary compilation

# ============================================================================
# Stage 1: Build
# ============================================================================
FROM golang:1.25-alpine AS builder

# Install build dependencies
# - gcc, musl-dev: CGO support
# - vips-dev: Image processing with libvips
# - ca-certificates: HTTPS support
RUN apk add --no-cache \
    gcc \
    musl-dev \
    vips-dev \
    ca-certificates \
    tzdata

WORKDIR /build

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download
RUN go mod verify

# Copy source code
COPY . .

# Build static binary
# - CGO_ENABLED=1: Required for vips
# - -ldflags: Strip debug info, make static
# - -trimpath: Remove local path information
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s' \
    -trimpath \
    -o /build/worker \
    ./cmd/worker

# Verify binary
RUN /build/worker --version 2>&1 || echo "Worker built successfully"

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM alpine:3.21

# Install runtime dependencies
# - vips: Image processing library (must match builder libc)
# - ca-certificates: HTTPS support
# - tzdata: Timezone data
RUN apk add --no-cache \
    vips \
    ca-certificates \
    tzdata

# Create non-root user
RUN addgroup -g 10001 -S appuser && \
    adduser -u 10001 -S appuser -G appuser

# Copy application binary
COPY --from=builder /build/worker /app/worker

# Use non-root user
USER 10001:10001

WORKDIR /app

# Set environment defaults
ENV ENVIRONMENT=production \
    LOG_FORMAT=json \
    LOG_LEVEL=info \
    WORKER_CONCURRENCY=10

ENTRYPOINT ["/app/worker"]
