# ============================================================================
# Multi-stage Dockerfile for API Server
# ============================================================================
# Build stage uses full Go image, runtime uses minimal Alpine image
# Security features:
# - Non-root user (10001:10001)
# - Minimal attack surface (Alpine)
# - Static compilation (except CGO libs)

# ============================================================================
# Stage 1: Build
# ============================================================================
FROM golang:1.25-alpine AS builder

# Install build dependencies
# - gcc, musl-dev: CGO support
# - vips-dev: Image processing with libvips
# - ca-certificates: HTTPS support
RUN apk add --no-cache \
    gcc \
    musl-dev \
    vips-dev \
    ca-certificates \
    tzdata

WORKDIR /build

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download
RUN go mod verify

# Copy source code
COPY . .

# Build binary
# - CGO_ENABLED=1: Required for vips
# - -ldflags: Strip debug info
# - -trimpath: Remove local path information
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s' \
    -trimpath \
    -o /build/api \
    ./cmd/api

# Verify binary
RUN /build/api --version 2>&1 || echo "API server built successfully"

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM alpine:3.21

# Install runtime dependencies
# - vips: Required for image processing
# - ca-certificates: Required for HTTPS
# - tzdata: Required for timezones
RUN apk add --no-cache \
    vips \
    ca-certificates \
    tzdata

# Create non-root user
RUN addgroup -g 10001 -S nonroot && \
    adduser -u 10001 -S nonroot -G nonroot

# Copy application binary
COPY --from=builder /build/api /app/api

# Use non-root user
USER 10001:10001

# Expose API port
EXPOSE 8080

# Health check port (metrics)
EXPOSE 9090

WORKDIR /app

# Set environment defaults
ENV ENVIRONMENT=production \
    LOG_FORMAT=json \
    LOG_LEVEL=info

ENTRYPOINT ["/app/api"]
