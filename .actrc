# Act configuration for local GitHub Actions testing
# https://github.com/nektos/act

# Use medium-sized images by default (includes most tools)
# Options: micro, medium, large (large is closest to real GitHub runners)
-P ubuntu-latest=catthehacker/ubuntu:act-latest
-P ubuntu-22.04=catthehacker/ubuntu:act-22.04
-P ubuntu-20.04=catthehacker/ubuntu:act-20.04

# Reuse containers for faster subsequent runs
--reuse

# Bind the working directory
--bind

# Use consistent artifact server address
--artifact-server-path=/tmp/act-artifacts

# Default to push events
--defaultbranch=main
